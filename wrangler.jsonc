{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "emnul-web",
  "compatibility_date": "2026-10-01",
  // nodejs_compat stays off until a dependency needs it
  "compatibility_flags": [],
  // The staging branch's Preview gets a workers.dev URL to review before it merges into main
  "preview_urls": true,
  // Production serves the apex only
  "routes": [{ "pattern": "emnul.dev", "custom_domain": true }],
  // Explicit because routes flip Wrangler's default: Production gets no workers.dev copy, while Previews keep theirs via preview_urls.
  "workers_dev": false,
  // Required by `wrangler preview`, which deploys the staging Preview from GitHub Actions
  "previews": {},
}
