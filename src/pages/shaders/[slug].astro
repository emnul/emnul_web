---
import type { GetStaticPaths } from "astro";
import type { ComponentProps } from "astro/types";
import { getImage, Image } from "astro:assets";
import { render } from "astro:content";
import MoireMagnifier from "../../moire-magnifier/MoireMagnifier";
import ShaderCanvas from "../../renderer/ShaderCanvas";
import { checkedShaders } from "../../shader-core/shaders";
import "../../styles/global.css";

export const getStaticPaths = (async () => {
  const shaders = await checkedShaders();
  return shaders.map(({ shader, source, still }) => ({
    params: { slug: shader.id },
    props: { shader, source, still },
  }));
}) satisfies GetStaticPaths;

const { shader, source, still } = Astro.props;
const { title, description } = shader.data;
const stillAlt = `Still frame of the ${title} Shader`;
// Link previews want an absolute URL, and JPEG works on every platform that shows one.
const ogImage = await getImage({
  src: still,
  width: 1200,
  format: "jpg",
});
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
// The Write-up: the body of `index.mdx`. A Shader without one renders nothing here.
const { Content: WriteUp } = await render(shader);

const island = {
  source,
  startTime: shader.data.still.time,
  parameters: shader.data.parameters,
};
// The Still shows until the canvas draws its first frame over it.
const stillImage: ComponentProps<typeof Image> = {
  src: still,
  alt: stillAlt,
  widths: [640, 1280],
  sizes: "(min-width: 720px) 65ch, 100vw",
  loading: "eager",
  fetchpriority: "high",
  class: "absolute inset-0 size-full object-cover",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · emnul.dev</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta
      property="og:image:width"
      content={String(ogImage.attributes.width)}
    />
    <meta
      property="og:image:height"
      content={String(ogImage.attributes.height)}
    />
    <meta property="og:image:alt" content={stillAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main class="prose mx-auto p-8">
      <h1>{title}</h1>
      <p>{description}</p>
      {
        // The Moiré magnifier's detector measures its renders, so it shares the canvas's island.
        // That island is its own, so the detector loads on no other page.
        shader.id === "moire-magnifier" ? (
          <MoireMagnifier client:load {...island}>
            <Image {...stillImage} />
          </MoireMagnifier>
        ) : (
          <ShaderCanvas client:load {...island}>
            <Image {...stillImage} />
          </ShaderCanvas>
        )
      }
      <WriteUp />
      <pre><code class="language-glsl">{source}</code></pre>
    </main>
  </body>
</html>
